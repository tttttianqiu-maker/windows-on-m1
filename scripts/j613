#!/bin/sh
# One entry point for the J613 workflow on the Hackintosh.
#   j613 watch   start the watcher (runs new ~/Downloads/j613-*.tar.gz builds)
#   j613 again   run the current build again (watcher must be running)
#   j613 probe   read-only MTP power probe (Air at "Running proxy...", watcher stopped)
#   j613 wifiprobe  read-only Wi-Fi/PCIe hardware map + full ADT (same conditions)
#   j613 log     input-related lines from the last run's hv.log
#   j613 input   verdict: keyboard/trackpad from m1n1 to the Windows driver
#   j613 hv      last 60 lines of hv.log
#   j613 build N build m1n1 natively (no Docker), reuse Mu -> ~/Downloads/j613-N.tar.gz
#   j613 mtp off|on  skip / allow the keyboard+trackpad (MTP) bring-up in m1n1
#   j613 screen on|off  show Windows on the Air's own screen (copy to the boot framebuffer)
#   j613 usb reset|normal  experimental guest-USB reset at Windows' xHCI start
#   j613 battery on|off  experimental battery % in Windows (m1n1 reads the SMC)
#   j613 kbdlight on|off  experimental keyboard backlight (Fn+F5 darker, Fn+F6 brighter)
#   j613 wifi probe|boot|off  built-in Wi-Fi test: probe = PCIe link, chip, OTP; boot = + firmware
#   j613 wifi "<name>" ["<password>"]  join that WPA2 network on the next runs (forget: drop it)
#   j613 wifisel  which Wi-Fi firmware files the next `wifi boot` run would load
#   j613 status  which build the watcher runs next, and the switches
#   j613 pull    git pull (repo + submodules)
#   j613 fw      install ~/Downloads/tpmtfw-j613.bin into firmware/
#   j613 wififw  install the newest ~/Downloads/j613-wifi-fw-*.tar.gz (from the Air's macOS)
#   j613 setup   make "j613" available in every terminal
ROOT=$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$0")")/.." && pwd)
cd "$ROOT" || exit 1
case "${1:-help}" in
    watch) exec sh scripts/j613-autorun.sh ;;
    again) mkdir -p runs && touch runs/.go && echo "re-run requested: the watcher starts it once the Air is at Running proxy..." ;;
    probe) git pull -q; exec sh scripts/j613-probe-mtp.sh ;;
    wifiprobe) exec sh scripts/j613-probe-wifi.sh ;;
    log)   grep -a -E "hv_mtp|dchid|rtkit" hv.log | tail -40 ;;
    input) shift; exec sh scripts/j613-input.sh "$@" ;;
    hv)    tail -60 hv.log ;;
    build) shift; exec sh scripts/j613-build-m1n1.sh "$@" ;;
    mtp)   mkdir -p firmware
           case "${2:-}" in
               off) touch firmware/no-mtp; echo "MTP bring-up OFF for the next runs" ;;
               on)  rm -f firmware/no-mtp; echo "MTP bring-up ON for the next runs" ;;
               *)   [ -e firmware/no-mtp ] && echo "MTP: off" || echo "MTP: on" ;;
           esac ;;
    screen) mkdir -p firmware
           case "${2:-}" in
               on)  touch firmware/screen-on; echo "Air screen ON for the next runs (needs build 39 or newer)" ;;
               off) rm -f firmware/screen-on; echo "Air screen OFF for the next runs" ;;
               *)   [ -e firmware/screen-on ] && echo "screen: on" || echo "screen: off" ;;
           esac ;;
    usb)   mkdir -p firmware
           case "${2:-}" in
               reset)  touch firmware/usb-reset; echo "guest USB: ordered reset ON for the next runs (experimental, build 40+)" ;;
               normal) rm -f firmware/usb-reset; echo "guest USB: ordered reset off" ;;
               *)      [ -e firmware/usb-reset ] && echo "usb: reset" || echo "usb: normal" ;;
           esac ;;
    battery) mkdir -p firmware
           case "${2:-}" in
               on)  touch firmware/battery; echo "Windows battery ON for the next runs (experimental, build 44+)" ;;
               off) rm -f firmware/battery; echo "Windows battery off" ;;
               *)   [ -e firmware/battery ] && echo "battery: on" || echo "battery: off" ;;
           esac ;;
    wifi)  mkdir -p firmware
           PY=proxyenv/bin/python; [ -x "$PY" ] || PY=python3
           case "${2:-}" in
               probe) rm -f firmware/wifi-boot; touch firmware/wifi-probe
                      echo "Wi-Fi probe ON for the next runs (PCIe link, chip, OTP; build 50+)" ;;
               boot)  [ -d firmware/wifi ] || { echo "first: j613 wififw (the Wi-Fi firmware from the Air's macOS)"; exit 1; }
                      rm -f firmware/wifi-probe; touch firmware/wifi-boot
                      echo "Wi-Fi firmware boot ON for the next runs (build 51+); then: j613 input" ;;
               off)   rm -f firmware/wifi-probe firmware/wifi-boot; echo "Wi-Fi off" ;;
               forget) exec "$PY" tools/j613/wifi_net.py forget ;;
               "")    if [ -e firmware/wifi-boot ]; then echo "wifi: boot"
                      elif [ -e firmware/wifi-probe ]; then echo "wifi: probe"; else echo "wifi: off"; fi
                      "$PY" tools/j613/wifi_net.py show ;;
               *)     [ "$2" = join ] && shift   # `j613 wifi join "<name>"` for a network called boot/off/...
                      [ -d firmware/wifi ] || { echo "first: j613 wififw (the Wi-Fi firmware from the Air's macOS)"; exit 1; }
                      "$PY" tools/j613/wifi_net.py set "$2" ${3+"$3"} || exit 1
                      rm -f firmware/wifi-probe; touch firmware/wifi-boot
                      echo "Wi-Fi boot + join ON for the next runs (build 51+); then: j613 input" ;;
           esac ;;
    wifisel) [ -d firmware/wifi ] || { echo "no firmware/wifi yet: j613 wififw"; exit 1; }
           A=$(ls -t runs/adt-*.bin 2>/dev/null | head -n 1)
           PY=proxyenv/bin/python; [ -x "$PY" ] || PY=python3
           exec "$PY" tools/j613/wifi_fw.py firmware/wifi --from-log hv.log ${A:+--adt "$A"} ;;
    kbdlight) mkdir -p firmware
           case "${2:-}" in
               on)  echo "${3:-3}" > firmware/kbdlight; echo "keyboard backlight ON (start level ${3:-3}/8) for the next runs (experimental, build 47+)" ;;
               off) rm -f firmware/kbdlight; echo "keyboard backlight off" ;;
               *)   [ -e firmware/kbdlight ] && echo "kbdlight: on" || echo "kbdlight: off" ;;
           esac ;;
    status) B=$(ls -t "$HOME"/Downloads/j613-*.tar.gz 2>/dev/null | head -n 1)
           echo "next build : ${B:-none} ($( [ -n "$B" ] && shasum -a 256 "$B" | cut -c1-12))"
           [ -e firmware/no-mtp ] && echo "MTP        : off" || echo "MTP        : on"
           [ -e firmware/tpmtfw-j613.bin ] && echo "trackpad fw: present" || echo "trackpad fw: absent (trackpad off)"
           [ -e firmware/screen-on ] && echo "Air screen : on" || echo "Air screen : off"
           [ -e firmware/usb-reset ] && echo "USB reset  : on (experimental)" || echo "USB reset  : off"
           [ -e firmware/battery ] && echo "battery    : on (experimental)" || echo "battery    : off"
           [ -e firmware/kbdlight ] && echo "kbdlight   : on (experimental)" || echo "kbdlight   : off"
           if [ -e firmware/wifi-boot ]; then echo "Wi-Fi      : boot (experimental)"
           elif [ -e firmware/wifi-probe ]; then echo "Wi-Fi      : probe (experimental)"; else echo "Wi-Fi      : off"; fi
           [ -d firmware/wifi ] && echo "Wi-Fi fw   : $(ls -d firmware/wifi/C-* 2>/dev/null | wc -l | tr -d ' ') macOS folder(s)" || echo "Wi-Fi fw   : absent (j613 wififw)"
           { [ -x proxyenv/bin/python ] && proxyenv/bin/python tools/j613/wifi_net.py show || python3 tools/j613/wifi_net.py show; } 2>/dev/null
           pgrep -f j613-autorun.sh >/dev/null && echo "watcher    : running" || echo "watcher    : NOT running (j613 watch)" ;;
    pull)  git pull && git submodule update --init ;;
    fw)    mkdir -p firmware && mv ~/Downloads/tpmtfw-j613.bin firmware/ && ls -la firmware/tpmtfw-j613.bin ;;
    wififw) T=$(ls -t "$HOME"/Downloads/j613-wifi-fw-*.tar.gz 2>/dev/null | head -n 1)
           [ -n "$T" ] || { echo "no ~/Downloads/j613-wifi-fw-*.tar.gz (run scripts/j613-wifi-fw.sh in macOS on the Air)"; exit 1; }
           rm -rf firmware/wifi && mkdir -p firmware/wifi && tar -xzf "$T" -C firmware/wifi &&
           echo "installed $(basename "$T"):" && ls firmware/wifi && sed -n 1,12p firmware/wifi/j613-wifi-info.txt ;;
    setup) mkdir -p "$HOME/bin" && ln -sf "$ROOT/scripts/j613" "$HOME/bin/j613" &&
           { grep -q 'HOME/bin' "$HOME/.zshrc" 2>/dev/null || echo 'export PATH="$HOME/bin:$PATH"' >> "$HOME/.zshrc"; } &&
           echo "done: open a new terminal and type  j613" ;;
    *)     sed -n 3,23p "$0" | sed 's/^# *//' ;;
esac
