<?xml version="1.0" encoding="utf-8"?>
<!-- J613 (MacBook Air M3) built-in keyboard and trackpad over the m1n1 AVHD page. -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|ARM64"><Configuration>Debug</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64"><Configuration>Release</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{3C6F2A8E-7B41-4D0A-9E52-6A1D0C613F13}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>AppleMtpInput</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>KMDF</DriverType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <TargetName>AppleMtpInput</TargetName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <!-- Shares sources with AppleInput.vcxproj in this folder: keep objects apart. -->
    <IntDir>$(Platform)\$(Configuration)\obj\AppleMtpInput\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile><AdditionalIncludeDirectories>include;..\protocol\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories><PreprocessorDefinitions>AI_KERNEL_MODE;%(PreprocessorDefinitions)</PreprocessorDefinitions><TreatWarningAsError>true</TreatWarningAsError></ClCompile>
    <Link><AdditionalDependencies>vhfkm.lib;Cng.lib;%(AdditionalDependencies)</AdditionalDependencies></Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\driver.c" />
    <ClCompile Include="src\device_avhd.c" />
    <ClCompile Include="src\transport_avhd.c" />
    <ClCompile Include="src\trackpad_pipeline.c" />
    <ClCompile Include="src\diagnostics.c" />
    <ClCompile Include="src\vhf_keyboard.c" />
    <ClCompile Include="src\vhf_trackpad.c" />
    <ClCompile Include="src\vhf_frontend.c" />
    <ClCompile Include="..\protocol\src\apple_hid_contract.c" />
    <ClCompile Include="..\protocol\src\apple_spi_plan.c" />
    <ClCompile Include="..\protocol\src\apple_spihid_crc.c" />
