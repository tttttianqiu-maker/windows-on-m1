    <ClCompile Include="..\protocol\src\apple_trackpad_axis.c" />
    <ClCompile Include="..\protocol\src\apple_trackpad_frame.c" />
    <ClCompile Include="..\protocol\src\apple_precision_touchpad.c" />
    <ClCompile Include="..\protocol\src\apple_mtp_adapt.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="include\apple_input_device.h" />
    <ClInclude Include="include\apple_input_avhd.h" />
    <ClInclude Include="include\apple_input_ioctl.h" />
    <ClInclude Include="include\apple_precision_touchpad_descriptor.h" />
    <ClInclude Include="..\protocol\include\apple_mtp.h" />
    <ClInclude Include="..\protocol\include\apple_trackpad.h" />
  </ItemGroup>
  <ItemGroup>
    <Inf Include="AppleMtpInput.inf" />
